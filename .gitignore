## Runtime log output captured per subsystem.
#logs/*
!logs/human/.gitkeep
!logs/machine/.gitkeep
## Secrets and OAuth material live outside of version control.
.env
credentials/*
#!credentials/service_account.json
#credentials/service_account.json
#gmail_token.json

# allow credential template files to be committed (but keep real credentials ignored)
!credentials/*TEMPLATE.json
!credentials/*.json.TEMPLATE
!credentials/gmail_oauth_client TEMPLATE.json

## Model weights and other large artifacts
weights/
!weights/.gitkeep
