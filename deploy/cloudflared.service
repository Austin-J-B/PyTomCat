[Unit]
Description=TomCat Cloudflare Tunnel (ui.catsofuta.org -> 127.0.0.1:8080)
Documentation=https://github.com/Austin-J-B/PyTomCat
# Start after the bot so 127.0.0.1:8080 and config.yml are in place. This is a
# best-effort ordering only; Restart=always covers the brief first-boot race
# where start.py has not finished (re)writing config.yml yet.
After=network-online.target tomcat.service
Wants=network-online.target

[Service]
Type=simple
User=tomcat
Group=tomcat
WorkingDirectory=/home/tomcat/PyTomCat
# Keep the binary current. "-" => ignore failures (incl. the refusal cloudflared
# emits when installed via a package manager). config.yml is regenerated by
# tomcat.service (scripts/start.py) on every start, so the tunnel always runs
# against the current ingress mapping.
ExecStartPre=-/home/tomcat/PyTomCat/cloudflared update
ExecStart=/home/tomcat/PyTomCat/cloudflared tunnel --config /home/tomcat/PyTomCat/config.yml run
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
