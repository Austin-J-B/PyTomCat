{"event": "dues_portal_analysis", "message_id": 1419371315147706438, "ts": "2025-09-21T17:14:52.175000+00:00", "author": "mica.aaa", "author_display": "Mica<3", "content": "Micaela Hamilton payed $15 via Cashapp", "provider": "cashapp", "handles": [], "name_guess": null, "primary_member": {"date": "9/21/2025", "full_name": "Micaela Hamilton", "discord_username": "mica.aaa", "payment_username": "N/A", "paid_where": "Cashapp", "kind": "$15 Donation, Discord Verification", "email": "axh8675@mavs.uta.edu", "semester": "Fall 2025", "verified": false, "mavorgs_invite": false, "donation_amount": ""}, "primary_email": {"event": "email_received", "id": "199822218a2d60d7", "subject": "Invitation to FLOC Networking Event - Connect and Collaborate!", "from": "\"Ponce, Andrea S\" <asp6148@mavs.uta.edu>", "ts_received": "2025-09-25T18:28:14Z", "ts_logged": "2025-09-25T15:55:01.077648-05:00", "content": "Dear UTA Organizations,\n\nI hope this email finds you well.\n\nThe Freshman Leaders on Campus at UTA is excited to invite your organization to a unique Networking Event on October 1st, from 6-8pm at Carlisle Hall. This event aims to connect our members with various organizations (such as yourselves) across campus, fostering a collaborative environment and showcasing opportunities beyond individual groups.\n\nWe believe that cross-organizational networking is crucial for personal and professional growth. This event provides a platform four our members to engage with peers from different and similar fields, exchanging ideas, and discover new avenues for collaboration.\n\nTo maximize your organization’s exposure, we encourage you to bring flyers and set up a small table to promote your activities and opportunities. We are happy to assist with printing flyers if needed.\n\nGiven the short notice we understand the need for flexibility. We sincerely hope you will consider this valuable opportunity to connect, collaborate, and expand horizons. Please RSVP by Friday 9/26 so we can make the necessary arrangements.\n\nWe look forward to seeing you there!\n\nBest regards,\n\nAndrea Ponce\nVice President\nFreshman Leaders on Campus (FLOC)\nasp6148@mavs.uta.edu<mailto:asp6148@mavs.uta.edu>\n\nP.S. If you have any questions please don’t hesitate to reach out to asp6148@mavs.uta.edu<mailto:asp6148@mavs.uta.edu> (my email) or aht0065@mavs.uta.edu<mailto:aht0065@mavs.uta.edu> (our president’s).\n\n"}, "payment_username_email": null, "payment_username_sheet": "N/A", "flag_reason": null, "score_sheet": 0.7, "score_email": 0.2, "score_total": 0.8999999999999999, "reasons": ["discord_handle_overlap", "provider_in_sheet", "timing_delta_h=97.22"]}
